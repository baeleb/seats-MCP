# --- Authentication ---
# The server prefers OAuth when OAuth credentials + a stored token are present,
# otherwise it falls back to the Partner API key below. Set whichever you use.

# Option 1: static Partner API key (Pro plan)
SEATS_AERO_API_KEY=your_api_key_here

# Option 2: OAuth2 (connect a user's seats.aero account)
# Register an app to obtain these, then run: seats-mcp auth login
# Redirect URI must be a public HTTPS URL registered with seats.aero (not localhost).
SEATS_OAUTH_CLIENT_ID=your_client_id
SEATS_OAUTH_CLIENT_SECRET=your_client_secret
SEATS_OAUTH_REDIRECT_URI=https://github.com/you/your-repo
# Optional overrides:
# SEATS_OAUTH_TOKEN_FILE=/custom/path/token.json
# SEATS_OAUTH_BASE_URL=https://seats.aero/oauth2
